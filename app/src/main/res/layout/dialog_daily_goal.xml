<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:elevation="8dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_daily_goal"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:title="Chọn mục tiêu hàng ngày"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <RadioGroup
        android:id="@+id/radio_group_daily_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_large"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_5_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_10_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_15_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_20_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="20 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_25_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="25 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_30_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="30 từ"
            android:textSize="@dimen/text_size_large"
            android:padding="@dimen/spacing_medium" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_margin="@dimen/spacing_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy"
            android:textSize="@dimen/text_size_medium"
            android:layout_marginEnd="@dimen/spacing_medium"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xác nhận"
            android:textSize="@dimen/text_size_medium" />
    </LinearLayout>
</LinearLayout>